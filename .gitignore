.ipynb_checkpoints/
*.ipynb_checkpoints

# Distribution / build
dist/
build/
*.egg-info/
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover

# Editors & IDEs
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

