*.pth
*.pt
*.ckpt
*.h5
*.pkl

# Generated figures (reproducible from notebook)
IEEE_Research_Figures_Full.png
IEEE_Research_Figures_Full.pdf
IEEE_Supplementary_Figures.png
IEEE_Supplementary_Figures.pdf

# Zip bundles
*.zip

# Large raw data (use Git LFS or DVC instead)
